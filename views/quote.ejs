<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>הצעת מחיר <%= q.number %> · <%= C.name %></title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<% const statusLabel = {pending:'ממתין לאישור וחתימה דיגיטלית', approved:'אושר ונחתם', expired:'פג תוקף', draft:'טיוטה'}; const st = approval ? 'approved' : (expired ? 'expired' : q.status); %>
<% if (preview) { %><div class="preview-bar">תצוגה מקדימה (מנהל) · הלקוח רואה את זה אחרי הזנת טלפון · <a href="/admin/edit/<%= q.number %>">חזרה לעריכה</a></div><% } %>
<div class="page">
  <div class="brand">
    <div>
      <div class="mono">PROPOSAL <span style="color:var(--maroon)"><%= q.number %></span></div>
      <div class="mono"><%= statusLabel[st] %></div>
    </div>
    <div class="name"><img src="<%= C.logo_url %>" alt=""> <%= C.name %></div>
  </div>
  <hr class="strong">
  <h1 class="title">הצעת מחיר</h1>
  <p class="subtitle"><%= q.title %></p>
  <hr class="soft" style="border-top:2px solid var(--maroon)">

  <div class="meta">
    <div><div class="k">לקוח</div><div class="v"><%= q.client_name %></div><div class="s">טלפון: <%= q.client_phone %></div></div>
    <div><div class="k">תאריך הצעה</div><div class="v"><%= issued %></div><div class="s">תוקף: <%= q.valid_days %> יום (עד <%= expires %>)</div></div>
    <div><div class="k">מחיר ההקמה</div><div class="v"><%= fmt(subtotal) %> ₪</div><div class="s"><%= showVat ? 'בתוספת מע"מ' : 'לפני מע"מ' %> · <%= comps.length %> רכיבים</div></div>
    <div><div class="k">מספר הצעה</div><div class="v"><%= q.number %></div><div class="s">מסמך זה ונספחיו</div></div>
  </div>
  <hr class="soft">

  <div class="sec"><h2><span class="n">01</span> תיאור המערכת</h2><p><%- description.replace(/\n/g,'<br>') %></p></div>

  <div class="sec"><h2><span class="n">02</span> היקף העבודה והמחיר</h2><p>מחיר קבוע לכל רכיב. פירוט הרכיבים בנספח א.</p>
    <table style="margin-top:12px"><thead><tr><th>יחידה</th><th class="num">לפני מע"מ</th></tr></thead>
    <tbody><tr><td style="font-weight:700"><%= lineLabel %>, <%= comps.length %> רכיבים</td><td class="num"><%= fmt(subtotal) %> ₪</td></tr></tbody></table>
    <div class="totals">
      <% if (showVat) { %>
      <div class="row"><span class="k mono">לפני מע"מ</span><span class="big"><%= fmt(subtotal) %> ₪</span></div>
      <div class="row"><span class="mono">מע"מ <%= vat %>%</span><span><%= fmt(vatAmt) %> ₪</span></div>
      <div class="row grand"><span class="mono" style="color:var(--maroon)">סה"כ כולל מע"מ</span><span><%= fmt(total) %> ₪</span></div>
      <% } else { %>
      <div class="row grand"><span class="mono" style="color:var(--maroon)">סה"כ</span><span><%= fmt(subtotal) %> ₪</span></div>
      <% } %>
    </div>
  </div>

  <div class="sec"><h2><span class="n">03</span> איך מתקדמים</h2>
    <div class="stages"><% stages.forEach((s,i)=>{ %>
      <div class="stage"><div class="n">שלב <%= String(i+1).padStart(2,'0') %></div><div class="t"><%= s.title %></div><div class="d"><%= s.desc %></div></div>
    <% }) %></div>
  </div>

  <div class="footer mono"><span><%= q.number %> · <%= new Date(q.issued_at).getFullYear() %></span><span><%= C.name.toUpperCase() %> · <%= C.tagline %></span><span><%= C.website %></span></div>

  <!-- נספח א -->
  <div class="annex">
    <div class="label">נספח א</div><h2>פירוט הרכיבים</h2>
    <p class="lead">לכל רכיב: מה הוא עושה בפועל, מה כלול בו ומה הוא נותן לעסק. המחיר קבוע לכל רכיב.</p>
    <table style="margin-top:14px"><thead><tr><th>#</th><th>רכיב</th><th class="num">לפני מע"מ</th></tr></thead><tbody>
      <% comps.forEach(c=>{ %><tr><td class="mono"><%= c.idx %></td><td style="font-weight:700"><%= c.name %></td><td class="num"><%= fmt(c.price) %> ₪</td></tr><% }) %>
      <tr><td></td><td style="font-weight:800">סה"כ</td><td class="num"><%= fmt(subtotal) %> ₪</td></tr>
    </tbody></table>

    <% if (outcomes.length) { %>
    <div class="sec"><div class="label">בסיום ההקמה</div><ul class="check" style="padding:0;margin-top:8px"><% outcomes.forEach(o=>{ %><li><%= o %></li><% }) %></ul></div>
    <% } %>

    <% comps.forEach(c=>{ %>
    <div class="comp">
      <div class="head"><h3><span class="mono" style="font-size:14px"><%= c.idx %>.</span> <%= c.name %></h3><div class="price"><%= fmt(c.price) %> ₪</div></div>
      <% if (c.desc) { %><p class="desc"><%- String(c.desc).replace(/\n/g,'<br>') %></p><% } %>
      <% if (c.bullets && c.bullets.length) { %><ul><% c.bullets.forEach(b=>{ %><li><%= b %></li><% }) %></ul><% } %>
    </div>
    <% }) %>
  </div>

  <!-- נספח ב -->
  <div class="annex">
    <div class="label">נספח ב</div><h2>תנאים והסכמות</h2>
    <p class="lead">התנאים חלים על הצעה זו ועל נספחיה. חתימה על ההצעה היא ההסכמה לתנאים אלה.</p>
    <ol class="terms" style="margin-top:14px"><% terms.forEach(t=>{ %><li><span><% if (t.title) { %><b><%= t.title %>:</b> <% } %><%= t.text %></span></li><% }) %></ol>
  </div>

  <!-- חתימה -->
  <div class="sign" id="sign">
    <% if (approval) { %>
      <h3>ההצעה אושרה</h3>
      <div class="done">✓ אושר ונחתם דיגיטלית על ידי <%= approval.signer_name %> · <%= new Date(approval.at + 'Z').toLocaleString('he-IL',{timeZone:'Asia/Jerusalem'}) %></div>
      <p class="small">סכום ההקמה: <%= fmt(total) %> ₪ <%= showVat ? 'כולל מע"מ' : 'לפני מע"מ' %>. ניצור קשר להמשך.</p>
    <% } else if (expired) { %>
      <h3>תוקף ההצעה פג</h3><p>ההצעה הייתה בתוקף עד <%= expires %>. לחידוש ההצעה פנה אלינו: <a href="mailto:<%= C.email %>"><%= C.email %></a></p>
    <% } else { %>
      <h3>אישור וחתימה דיגיטלית</h3>
      <p>בחתימה אני מאשר/ת את הצעת מחיר <b><%= q.number %></b> על סך <b><% if (showVat) { %><%= fmt(subtotal) %> ₪ + מע"מ (<%= fmt(total) %> ₪ כולל מע"מ)<% } else { %><%= fmt(subtotal) %> ₪ לפני מע"מ<% } %></b> ואת התנאים בנספח ב.</p>
      <label>שם מלא של המאשר/ת</label>
      <input id="signer" placeholder="שם מלא" <%= preview ? 'disabled' : '' %>>
      <div style="margin-top:14px;display:flex;gap:10px;flex-wrap:wrap">
        <button class="btn maroon" id="approveBtn" <%= preview ? 'disabled' : '' %>>מאשר/ת את ההצעה</button>
        <a class="btn ghost" href="javascript:window.print()">הדפסה / PDF</a>
      </div>
      <div id="signErr" class="err" style="display:none"></div>
    <% } %>
  </div>

  <div class="footer mono"><span><%= q.number %> · <%= C.hp ? 'ח.פ. ' + C.hp : '' %></span><span><%= C.name_he %> · <%= C.address %></span><span><%= C.email %></span></div>
</div>
<script>
const b=document.getElementById('approveBtn');
if(b){b.onclick=async()=>{const name=document.getElementById('signer').value.trim();const e=document.getElementById('signErr');e.style.display='none';
 if(name.length<2){e.textContent='נא להזין שם מלא';e.style.display='block';return}
 if(!confirm('לאשר את ההצעה בשם "'+name+'"?'))return; b.disabled=true;
 const r=await fetch(location.pathname+'/approve',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name})});
 const j=await r.json(); if(j.ok)location.href=location.pathname+'#sign',location.reload(); else{e.textContent=j.error||'שגיאה';e.style.display='block';b.disabled=false}}}
</script>
</body>
</html>
