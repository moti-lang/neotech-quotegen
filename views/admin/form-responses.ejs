<!DOCTYPE html><html lang="he" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex"><title>תשובות · <%= f.title %></title><link rel="stylesheet" href="/style.css"></head>
<body><div class="adm">
<%- include('_nav', { navTitle: 'תשובות' }) %>
<% const link = baseUrl + '/f/' + f.id; %>
<div class="card">
  <div class="row-actions">
    <h2 style="margin:0;font-size:24px"><%= f.title %></h2>
    <span class="badge <%= f.status === 'open' ? 'approved' : 'draft' %>"><%= f.status === 'open' ? 'פתוח' : 'סגור' %></span>
    <span style="margin-right:auto"><b style="font-size:22px;color:var(--navy)"><%= responses.length %></b> תשובות</span>
  </div>
  <div class="row-actions" style="margin-top:10px">
    <span class="copy small" data-copy="<%= link %>"><%= link %></span>
    <a class="btn sm ghost" href="/admin/forms/edit/<%= f.id %>">עריכת הטופס</a>
    <% if (responses.length) { %><a class="btn sm ghost" href="/admin/forms/<%= f.id %>/export.csv">הורדה לאקסל (CSV)</a><% } %>
  </div>
</div>

<% if (!responses.length) { %>
  <div class="card small" style="text-align:center;padding:30px">עדיין אף אחד לא מילא את הטופס. שלח את הקישור והתשובות יופיעו כאן.</div>
<% } else { %>

<div class="row-actions" style="margin-bottom:12px">
  <button class="btn sm" id="tabSum" onclick="tab('sum')">סיכום</button>
  <button class="btn sm ghost" id="tabAll" onclick="tab('all')">כל תשובה בנפרד</button>
</div>

<div id="sum">
<% summary.forEach((q, i) => { %>
  <div class="card">
    <div style="font-weight:700;margin-bottom:8px"><span class="mono" style="color:var(--navy)"><%= i + 1 %>.</span> <%= q.text %></div>
    <% if (q.type === 'text') { %>
      <% if (!q.texts.length) { %><div class="small">אין תשובות</div><% } %>
      <% q.texts.forEach(t => { %><div class="txtans"><%= t.v %><% if (t.name) { %> <span class="small">— <%= t.name %></span><% } %></div><% }) %>
    <% } else { const max = Math.max(1, q.answered); %>
      <% q.counts.forEach(c => { const pct = Math.round(c.n / max * 100); %>
        <div class="bar-row">
          <div class="bar-label"><%= c.o %></div>
          <div class="bar"><div class="bar-fill" style="width:<%= pct %>%"></div></div>
          <div class="bar-num"><b><%= c.n %></b> <span class="small">(<%= pct %>%)</span></div>
        </div>
      <% }) %>
      <div class="small"><%= q.answered %> ענו על השאלה<%= q.type === 'multi' ? ' · אפשר היה לבחור כמה תשובות' : '' %></div>
    <% } %>
  </div>
<% }) %>
</div>

<div id="all" style="display:none">
<% responses.forEach((r, n) => { %>
  <div class="card">
    <div class="row-actions" style="margin-bottom:8px">
      <b>#<%= responses.length - n %></b>
      <% if (r.name) { %><b><%= r.name %></b><% } %>
      <% if (r.phone) { %><a class="ltr" href="https://wa.me/<%= r.phone.replace(/\D/g,'').replace(/^0/,'972') %>" target="_blank"><%= r.phone %></a><% } %>
      <span class="small" style="margin-right:auto"><%= fmtDT(r.at) %></span>
      <form method="post" action="/admin/forms/<%= f.id %>/response/<%= r.id %>/delete" onsubmit="return confirm('למחוק את התשובה הזו?')"><button class="btn sm ghost" style="padding:3px 8px">מחק</button></form>
    </div>
    <% f.questions.forEach((q, i) => { const v = r.answers[i]; %>
      <div class="ans-row"><div class="small"><%= q.text %></div><div><b><%= Array.isArray(v) ? (v.join(', ') || '—') : (v || '—') %></b></div></div>
    <% }) %>
  </div>
<% }) %>
</div>
<% } %>

<div class="toast" id="toast">הקישור הועתק</div>
<script>
document.querySelectorAll('.copy').forEach(e=>e.onclick=()=>{navigator.clipboard.writeText(e.dataset.copy);const t=document.getElementById('toast');t.style.display='block';setTimeout(()=>t.style.display='none',1500)});
function tab(t){ document.getElementById('sum').style.display=t==='sum'?'':'none'; document.getElementById('all').style.display=t==='all'?'':'none';
  document.getElementById('tabSum').className='btn sm'+(t==='sum'?'':' ghost'); document.getElementById('tabAll').className='btn sm'+(t==='all'?'':' ghost'); }
</script>
</div></body></html>
